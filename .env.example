# Copy to .env (git-ignored) and set local development values. Never commit real secrets.
SCAFFOLD_DB_PASSWORD=
# Any identifier for the login-attempt HMAC key, e.g. local-dev-1
KOIKI_SOURCE_HMAC_KEY_ID=
# Base64 of at least 32 random bytes, e.g. from: openssl rand -base64 32
KOIKI_SOURCE_HMAC_KEY=
